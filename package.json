{
    "name": "key-level-insights",
    "version": "1.0.0",
    "description": "A full-stack project to track and visualize dungeon performance stats from Warcraft Logs.",
    "scripts": {
        "start-install": "npm install",
        "install-backend": "cd backend && npm install",
        "install-frontend": "cd frontend && npm install",
        "install-all": "npm run install-backend && npm run install-frontend",
        "build-backend": "cd backend && npm run build",
        "build-frontend": "cd frontend && npm run build",
        "build": "npm run build-backend && npm run build-frontend",
        "start-frontend": "cd frontend && npm run preview",
        "start-backend": "cd backend && npm run start",
        "dev-backend": "cd backend && npm run dev",
        "dev-frontend": "cd frontend && npm run dev",
        "dev": "concurrently \"npm run dev-backend\" \"npm run dev-frontend\"",
        "deploy-fresh-docker": "docker-compose up --force-recreate --build -d && docker-compose up -d",
        "deploy-backend": "cd backend && docker-compose build && docker-compose push",
        "deploy-frontend": "cd frontend && docker-compose build && docker-compose push"
    },
    "dependencies": {
        "@typescript-eslint/eslint-plugin": "^8.71.2",
        "@typescript-eslint/parser": "^8.71.2",
        "concurrently": "^10.0.6",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "prettier": "^3.9.10",
        "tsconfig-paths": "^4.2.0"
    },
    "author": "Harry Carr",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^26.6.5"
    }
}
